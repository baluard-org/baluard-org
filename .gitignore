# Zola build artifacts
site/public/

# Package binaries and installers (distributed via GitHub Releases, not git tree)
*.deb
*.rpm
*.AppImage
*.exe
*.msi
*.dmg
*.pkg
*.apk
!fdroid/repo/*.apk
*.tar.gz
*.tar.xz
*.tar.bz2
*.zip
*.7z

# Compiled binaries and libraries
*.bin
*.so
*.dylib
*.dll

# OS noise and editor temp files
.DS_Store
Thumbs.db
*.tmp
*~


# F-Droid index signature jars (the global git ignore excludes *.jar)
!fdroid/repo/*.jar

# apt/dnf pool binaries: the package repos on baluard.app/repo serve these
# from this tree; ignoring them 404s every apt/dnf install (metadata ships,
# the package download fails)
!repo/pool/**/*.deb
!repo/rpms/*.rpm
